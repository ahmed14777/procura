# Server-side only. Never expose this value with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY= 

# Optional: override the cost-effective default model.
OPENAI_DOCUMENT_MODEL=gpt-4.1-mini

# Vercel Blob + Upstash Redis (server-side only).
BLOB_READ_WRITE_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional but recommended for authenticating the Vercel cleanup cron.
CRON_SECRET=

# Shared staff login. SESSION_SECRET should be a random 64-character value.
STAFF_ACCESS_PASSWORD=
SESSION_SECRET=

# Optional: separate elevated password that also unlocks extension-license
# (activation code) management at /extension-licenses. Reuses SESSION_SECRET.
ADMIN_ACCESS_PASSWORD=

